NODE_ENV=development
PORT=4000

# Optional: connect to a real MongoDB deployment instead of the in-memory server
# MONGODB_URI=mongodb://127.0.0.1:27017/school_inventory

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Password reset links are built from this origin, and links expire after N minutes
PUBLIC_ORIGIN=http://localhost:4000
RESET_TOKEN_TTL_MINUTES=30

# Bootstrap administrator created by the seed script.
# Leave SEED_ADMIN_PASSWORD empty to have a random password printed once to the console.
SEED_ADMIN_NAME=Laboratory Administrator
SEED_ADMIN_EMAIL=lab.admin@cvsu.edu.ph
SEED_ADMIN_PASSWORD=

# Optional SMTP delivery for password reset emails.
# Without SMTP_HOST the reset link is logged to the server console (development).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=School Inventory System <no-reply@cvsu.edu.ph>
